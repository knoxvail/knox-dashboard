# Copy this file to .env.local and fill in your values
# These also go into Vercel as Environment Variables

# Site URL (used for OAuth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Notion Integration Token
# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database IDs
# Your Task database ID
NOTION_DB_ID=203c40abce39801888d2d2a9035be3ed
# Your Schedule database ID
NOTION_SCHEDULE_DB_ID=79a404f0c0214c8d8d0af5e76d655224

# Spotify
# Get from: https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=https://knox-dashboard-pnsj.vercel.app/api/spotify/callback

# Google (Gmail)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gmail user account index (0 for primary account, 1 for second, etc.)
GMAIL_USER_INDEX=0

# Timezone for schedule display (e.g., America/Los_Angeles, America/New_York, UTC)
TZ=America/Los_Angeles
